{
  "rules": {
    "requests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "allowlist": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "shared": {
      "data": {
        ".read": "auth != null && root.child('allowlist').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('allowlist').child(auth.uid).val() === true"
      }
    }
  }
}
